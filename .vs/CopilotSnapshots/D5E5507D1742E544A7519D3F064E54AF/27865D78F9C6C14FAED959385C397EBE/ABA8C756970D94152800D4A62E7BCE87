using System;
using System.Collections.Generic;
using System.Text;
using Lib;
using Raylib_cs;
using static Raylib_cs.Raylib;

namespace DiscRoom
{
    public class SceneGame : AScene
    {

        private Hero _player;



        public SceneGame()
        {
            _player = new Hero();

        }

        public override void Update(float dt)
        {
            _player.Update(dt);
        }

        public override void Draw()
        {
            int posX = 0;
            int posY = 0;

            for(int i = 0; i <= 16; i++)
            {
                for(int j = 0; j <= 16; j++)
                {
                    DrawRectangle(0 + posX,0+posY,)
                }
            }


            _player.Draw();
        }


    }
}
